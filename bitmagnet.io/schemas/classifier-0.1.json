{
  "$id": "https://bitmagnet.io/schemas/classifier-0.1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "action": {
      "oneOf": [
        {
          "$ref": "#/definitions/action_single"
        },
        {
          "$ref": "#/definitions/action_multi"
        }
      ]
    },
    "action__add_tag": {
      "additionalProperties": false,
      "description": "为当前种子添加一个或多个标签",
      "properties": {
        "add_tag": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "add_tag"
      ],
      "type": "object"
    },
    "action__attach_local_content_by_id": {
      "const": "attach_local_content_by_id",
      "description": "使用种子提示通过ID关联本地存储的内容"
    },
    "action__attach_local_content_by_search": {
      "const": "attach_local_content_by_search",
      "description": "尝试通过种子名称搜索关联本地内容"
    },
    "action__attach_tmdb_content_by_id": {
      "const": "attach_tmdb_content_by_id",
      "description": "使用种子提示通过ID关联TMDB API的内容"
    },
    "action__attach_tmdb_content_by_search": {
      "const": "attach_tmdb_content_by_search",
      "description": "尝试通过种子名称搜索关联TMDB API的内容"
    },
    "action__delete": {
      "const": "delete",
      "description": "删除当前种子"
    },
    "action__find_match": {
      "additionalProperties": false,
      "description": "遍历一系列操作，查找第一个未返回unmatched错误的操作",
      "properties": {
        "find_match": {
          "items": {
            "$ref": "#/definitions/action_single"
          },
          "type": "array"
        }
      },
      "required": [
        "find_match"
      ],
      "type": "object"
    },
    "action__if_else": {
      "additionalProperties": false,
      "description": "根据条件执行操作",
      "properties": {
        "if_else": {
          "additionalProperties": false,
          "properties": {
            "condition": {
              "$ref": "#/definitions/condition"
            },
            "else_action": {
              "$ref": "#/definitions/action"
            },
            "if_action": {
              "$ref": "#/definitions/action"
            }
          },
          "required": [
            "condition"
          ],
          "type": "object"
        }
      },
      "required": [
        "if_else"
      ],
      "type": "object"
    },
    "action__parse_date": {
      "const": "parse_date",
      "description": "尝试从当前种子的名称中解析日期"
    },
    "action__parse_video_content": {
      "const": "parse_video_content",
      "description": "从当前种子的名称中解析与视频相关的属性"
    },
    "action__run_workflow": {
      "additionalProperties": false,
      "description": "在当前工作流中运行其他工作流",
      "properties": {
        "run_workflow": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "run_workflow"
      ],
      "type": "object"
    },
    "action__set_content_type": {
      "additionalProperties": false,
      "description": "设置当前种子的内容类型",
      "properties": {
        "set_content_type": {
          "enum": [
            "movie",
            "tv_show",
            "music",
            "ebook",
            "comic",
            "audiobook",
            "game",
            "software",
            "xxx",
            "unknown"
          ],
          "type": "string"
        }
      },
      "required": [
        "set_content_type"
      ],
      "type": "object"
    },
    "action__unmatched": {
      "const": "unmatched",
      "description": "为当前种子返回unmatched错误"
    },
    "action_multi": {
      "items": {
        "$ref": "#/definitions/action_single"
      },
      "type": "array"
    },
    "action_single": {
      "oneOf": [
        {
          "$ref": "#/definitions/action__add_tag"
        },
        {
          "$ref": "#/definitions/action__attach_local_content_by_id"
        },
        {
          "$ref": "#/definitions/action__attach_local_content_by_search"
        },
        {
          "$ref": "#/definitions/action__attach_tmdb_content_by_id"
        },
        {
          "$ref": "#/definitions/action__attach_tmdb_content_by_search"
        },
        {
          "$ref": "#/definitions/action__delete"
        },
        {
          "$ref": "#/definitions/action__find_match"
        },
        {
          "$ref": "#/definitions/action__if_else"
        },
        {
          "$ref": "#/definitions/action__unmatched"
        },
        {
          "$ref": "#/definitions/action__parse_date"
        },
        {
          "$ref": "#/definitions/action__parse_video_content"
        },
        {
          "$ref": "#/definitions/action__run_workflow"
        },
        {
          "$ref": "#/definitions/action__set_content_type"
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/definitions/condition__and"
        },
        {
          "$ref": "#/definitions/condition__not"
        },
        {
          "$ref": "#/definitions/condition__or"
        },
        {
          "$ref": "#/definitions/condition__expression"
        }
      ]
    },
    "condition__and": {
      "additionalProperties": false,
      "properties": {
        "and": {
          "description": "如果列表中的所有条件都满足，则该条件满足",
          "items": {
            "$ref": "#/definitions/condition"
          },
          "type": "array"
        }
      },
      "required": [
        "and"
      ],
      "type": "object"
    },
    "condition__expression": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "expression": {
              "description": "描述条件的CEL表达式",
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "expression"
          ],
          "type": "object"
        },
        {
          "description": "描述条件的CEL表达式",
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "condition__not": {
      "additionalProperties": false,
      "description": "对提供的条件取反",
      "properties": {
        "not": {
          "$ref": "#/definitions/condition"
        }
      },
      "required": [
        "not"
      ],
      "type": "object"
    },
    "condition__or": {
      "additionalProperties": false,
      "properties": {
        "or": {
          "description": "如果列表中任一条件满足，则该条件满足",
          "items": {
            "$ref": "#/definitions/condition"
          },
          "type": "array"
        }
      },
      "required": [
        "or"
      ],
      "type": "object"
    }
  },
  "properties": {
    "$schema": {
      "const": "https://bitmagnet.io/schemas/classifier-0.1.json"
    },
    "extensions": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "flag_definitions": {
      "additionalProperties": {
        "enum": [
          "bool",
          "string",
          "int",
          "string_list",
          "content_type_list"
        ],
        "type": "string"
      },
      "type": "object"
    },
    "flags": {
      "additionalProperties": true,
      "type": "object"
    },
    "keywords": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "type": "object"
    },
    "workflows": {
      "additionalProperties": {
        "$ref": "#/definitions/action"
      },
      "type": "object"
    }
  },
  "type": "object"
}
